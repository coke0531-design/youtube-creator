  <!-- ============ 캔버스 카메라 헬퍼 (window.__cam) — 2026-09-13 실험 ============
       슬라이드 로컬 GSAP 타임라인 안에서만 쓴다. 전부 fromTo (seek 왕복 안전).
       좌표 = 디자인 px (1920x1080). 자막 안전영역(하단 230px)을 뺀 영역 가운데에 대상을 잡는다.
       __cam.shot(tl, canvasSel, targetSels, at, {zoom, pad, dur, ease, safe})   대상(들)을 잡는다(팬/줌)
       __cam.fit(tl, canvasSel, at, {…})                                         canvas 안 .cv-item 전부를 잡는다(전체 보기)
       __cam.ghost(tl, sel, at, {dur, y, blur})                                  유령(옅음) → 실체 등장
       __cam.draw(tl, sel, at, {dur, ease})                                      SVG path/line 이 그어짐
       __cam.swap(tl, outSel, inSel, at, {dur})                                  제자리 바꿔치기(교차)
       __cam.xfade(tl, outSel, inSel, at, {dur})                                 소장면 흐림 교차
       __cam.chips(tl, sels[], at, {gap, dur})                                   칩이 왼쪽부터 하나씩
       ⚠️ 카메라 scale 은 1 을 넘기지 않는다(zoom 은 상한). 클로즈업 = 1배로 디자인한다.
  -->
  <script>
    window.__cam = (function () {
      const VW = 1920, VH = 1080, SAFE = 230;
      const state = new Map();
      // GSAP fromTo 는 기본 immediateRender=true 라 '뒤 단계' 트윈의 from 값이 빌드 시점에 화면을 덮는다.
      // 규칙: 요소마다 첫 트윈만 즉시 렌더(초기 상태 확정), 이후 트윈은 immediateRender:false.
      const seen = new WeakSet();
      function ft(tl, target, from, to, at) {
        const els = typeof target === 'string' ? Array.from(document.querySelectorAll(target)) : [].concat(target);
        const first = els.some(e => !seen.has(e));
        els.forEach(e => seen.add(e));
        to = Object.assign({}, to, { immediateRender: first });
        return tl.fromTo(target, from, to, at);
      }
      function relRect(el, root) {
        let x = 0, y = 0, n = el;
        while (n && n !== root) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent; }
        return { l: x, t: y, w: el.offsetWidth, h: el.offsetHeight };
      }
      function union(root, sels) {
        let l = Infinity, t = Infinity, r = -Infinity, b = -Infinity, n = 0;
        [].concat(sels).forEach(s => root.querySelectorAll(s).forEach(el => {
          const q = relRect(el, root); n++;
          l = Math.min(l, q.l); t = Math.min(t, q.t); r = Math.max(r, q.l + q.w); b = Math.max(b, q.t + q.h);
        }));
        if (!n) throw new Error('__cam: 대상 없음 ' + JSON.stringify(sels));
        return { l, t, w: r - l, h: b - t };
      }
      function view(rect, o) {
        const zoom = Math.min(o.zoom == null ? 1 : o.zoom, 1);
        const pad = o.pad == null ? 90 : o.pad;
        const availH = o.safe === false ? VH : VH - SAFE;
        const s = Math.min(zoom, (VW - 2 * pad) / rect.w, (availH - 2 * pad) / rect.h);
        const cx = rect.l + rect.w / 2, cy = rect.t + rect.h / 2;
        return { x: Math.round(VW / 2 - s * cx), y: Math.round(availH / 2 - s * cy), scale: +s.toFixed(4) };
