            }
            const L = Math.ceil(p.getTotalLength ? p.getTotalLength() : 1000);
            const d = o.dur == null ? 0.6 : o.dur;
            p.style.strokeDasharray = L + ' ' + L;
            ft(tl, p, { opacity: 0 }, { opacity: 1, duration: 0.04 }, at);   // 둥근 선끝(cap)이 미리 비치는 것 방지
            ft(tl, p, { strokeDashoffset: L }, { strokeDashoffset: 0, duration: d, ease: o.ease || 'power2.inOut' }, at);
            const head = p.dataset.head ? document.querySelector(p.dataset.head) : null;
            if (head) ft(tl, head, { opacity: 0, scale: 0.6, transformOrigin: '0% 50%' }, { opacity: 1, scale: 1, transformOrigin: '0% 50%', duration: 0.2, ease: 'power2.out' }, at + d * 0.8);
          });
          return tl;
        },
        fade(tl, sel, at, o) {
          o = o || {};
          ft(tl, sel, { opacity: 0, scale: o.scale == null ? 0.96 : o.scale, transformOrigin: '50% 50%' },
            { opacity: 1, scale: 1, transformOrigin: '50% 50%', duration: o.dur == null ? 0.35 : o.dur, ease: 'power2.out' }, at);
