        const dur = (!from || o.dur === 0) ? 0.001 : (o.dur == null ? 1.0 : o.dur);
        const f = from || to;
        ft(tl, canvasSel, { x: f.x, y: f.y, scale: f.scale, transformOrigin: '0 0' },
          { x: to.x, y: to.y, scale: to.scale, transformOrigin: '0 0', duration: dur, ease: o.ease || 'power2.inOut' }, at);
