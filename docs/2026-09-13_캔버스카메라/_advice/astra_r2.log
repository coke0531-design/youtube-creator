        VW, VH, SAFE,
        shot(tl, canvasSel, targets, at, o) {
          o = o || {};
          const root = document.querySelector(canvasSel);
          return moveTo(tl, canvasSel, view(union(root, targets), o), at, o);
        },
        fit(tl, canvasSel, at, o) {
          o = o || {};
          const root = document.querySelector(canvasSel);
          return moveTo(tl, canvasSel, view(union(root, o.targets || '.cv-item'), o), at, o);
        },
        ghost(tl, sel, at, o) {
          o = o || {};
