          ft(tl, sel, { opacity: 0.38, filter: 'blur(1.5px)' },
            { opacity: 1, filter: 'blur(0px)', duration: dur * 0.6, ease: 'power2.out' }, at + dur * 0.45);
          return tl;
        },
        draw(tl, sel, at, o) {
          o = o || {};
          document.querySelectorAll(sel).forEach(p => {
            if (p.classList.contains('dotted')) {   // 점선은 dash 기반 draw 가 안 되므로 옅게 나타남
